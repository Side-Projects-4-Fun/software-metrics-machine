{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@smmachine/utils": ["../../packages/utils/src/*"],
      "@smmachine/core": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
