{
  "name": "@smmachine/launcher",
  "version": "0.6.20",
  "description": "Data-driven approach to software measurement for high-performing teams",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "smm": "dist/index.cjs"
  },
  "repository": {
    "url": "https://github.com/Side-Projects-4-Fun/software-metrics-machine"
  },
  "files": [
    "dist",
    "apps/cli/fetch-codemaat.sh",
    "apps/cli/tools",
    "apps/mcp/dist",
    "apps/webapp/.next/BUILD_ID",
    "apps/webapp/.next/*.json",
    "apps/webapp/.next/*.js",
    "apps/webapp/.next/server",
    "apps/webapp/.next/static",
    "apps/webapp/public",
    "README.md",
    "LICENSE"
  ],
  "author": "Marabesi",
  "license": "MIT",
  "scripts": {
    "build:local": "pnpm run lint -- --fix; pnpm run build; pnpm run test; pnpm run docs:build",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "coverage:clean": "rm -rf coverage apps/*/coverage packages/*/coverage",
    "coverage:collect": "pnpm --filter @smmachine/utils test:coverage && pnpm --filter @smmachine/core test:coverage && pnpm --filter @smmachine/cli test:coverage && pnpm --filter @smmachine/mcp test:coverage && pnpm --filter @smmachine/rest test:coverage && pnpm --filter @smmachine/webapp test:coverage",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:html": "genhtml --ignore-errors inconsistent,source,category --synthesize-missing coverage/lcov.info --output-directory coverage/merged-html",
    "coverage:all": "pnpm run coverage:clean && pnpm run coverage:collect && pnpm run coverage:merge",
    "coverage:all:html": "pnpm run coverage:all && pnpm run coverage:html",
    "lint": "turbo run lint",
    "lint:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "watch": "turbo run watch",
    "docs": "cd docs/vitepress && pnpm run docs:dev",
    "docs:build": "cd docs/vitepress && pnpm run docs:build",
    "clean:full": "rm -rf node_modules && (cd apps/mcp && rm -rf node_modules) && (cd apps/cli && rm -rf node_modules) && (cd apps/rest && rm -rf node_modules) && (cd apps/webapp && rm -rf node_modules) && (cd packages/core && rm -rf node_modules) && (cd packages/utils && rm -rf node_modules)",
    "clean:install": "pnpm run clean:full && pnpm install",
    "build:npm": "turbo run clean && pnpm --filter @smmachine/utils build && pnpm --filter @smmachine/core build && pnpm --filter @smmachine/rest build && pnpm --filter @smmachine/webapp build && pnpm --filter @smmachine/mcp build && pnpm exec tsup",
    "dev": "turbo run dev --filter=./apps/*",
    "build:packages": "turbo run build --filter=@smmachine/utils --filter=@smmachine/core",
    "test": "turbo run test",
    "test:cli:acceptance": "cd apps/cli && pnpm run test:e2e",
    "test:cli:acceptance:full": "bash scripts/simulate-and-test-publish.sh build cli-e2e",
    "test:cli:acceptance:docker": "bash scripts/simulate-and-test-publish.sh cli-e2e",
    "typecheck": "turbo run type-check",
    "cli": "cd ./apps/cli && pnpm run dev",
    "cli:e2e": "cd ./apps/cli && pnpm run test:e2e",
    "webapp:e2e": "cd ./apps/webapp && pnpm run cy:run",
    "webapp:e2e:open": "cd ./apps/webapp && pnpm run cy:open",
    "prepack": "pnpm run build:npm",
    "prepare": "husky"
  },
  "keywords": [
    "software-metrics",
    "dora",
    "deployment-frequency",
    "lead-time",
    "change-failure-rate",
    "mean-time-recovery"
  ],
  "engines": {
    "node": ">=26.4.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "dependencies": {
    "@emotion/cache": "catalog:",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@fontsource/roboto": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "@mui/material-nextjs": "catalog:",
    "@mui/x-date-pickers": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "dayjs": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "reflect-metadata": "catalog:",
    "rimraf": "catalog:",
    "rxjs": "catalog:",
    "sqlite": "catalog:",
    "swagger-ui-express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axios": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "concurrently": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "catalog:",
    "inquirer": "catalog:",
    "ora": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}