{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf*": "ask",
      "pnpm publish*": "ask",
      "pnpm audit fix*": "ask",
      "cd /*": "deny",
      "cd ~*": "deny"
    }
  }
}
